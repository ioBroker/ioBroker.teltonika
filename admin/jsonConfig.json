{
    "type": "tabs",
    "i18n": true,
    "items": {
        "mqttTab": {
            "type": "panel",
            "label": "MQTT",
            "items": {
                "_header1": {
                    "type": "header",
                    "text": "Connection settings",
                    "size": 3,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "bind": {
                    "newLine": true,
                    "type": "ip",
                    "label": "IP",
                    "listenOnAllPorts": true,
                    "xs": 12,
                    "sm": 10,
                    "md": 8,
                    "lg": 3,
                    "xl": 3
                },
                "port": {
                    "label": "Port",
                    "type": "number",
                    "min": 1,
                    "max": 65535,
                    "xs": 12,
                    "sm": 2,
                    "md": 2,
                    "lg": 1,
                    "xl": 1
                },
                "timeout": {
                    "label": "Client timeout",
                    "help": "in seconds",
                    "type": "number",
                    "min": 1,
                    "max": 99999,
                    "xs": 12,
                    "sm": 10,
                    "md": 2,
                    "lg": 1,
                    "xl": 1
                },
                "_header2": {
                    "newLine": true,
                    "type": "header",
                    "text": "Authentication settings",
                    "size": 3,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "user": {
                    "newLine": true,
                    "type": "text",
                    "label": "User",
                    "xs": 12,
                    "sm": 12,
                    "md": 4,
                    "lg": 2,
                    "xl": 2
                },
                "password": {
                    "xs": 12,
                    "sm": 12,
                    "md": 8,
                    "lg": 4,
                    "xl": 4,
                    "type": "password",
                    "label": "Password",
                    "repeat": true
                },
                "_header4": {
                    "newLine": true,
                    "type": "header",
                    "text": "Other settings",
                    "size": 3,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "ignorePings": {
                    "newLine": true,
                    "type": "checkbox",
                    "label": "Ignore warnings with pingreq",
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "pollInterval": {
                    "newLine": true,
                    "type": "number",
                    "label": "Poll interval",
                    "help": "in milliseconds",
                    "min": 1000,
                    "max": 60000,
                    "xs": 12,
                    "sm": 12,
                    "md": 4,
                    "lg": 2,
                    "xl": 2
                }
            }
        },
        "snmpTab": {
            "type": "panel",
            "label": "SNMP",
            "items": {
                "_headerScan": {
                    "type": "header",
                    "text": "Network scan",
                    "size": 3,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "_scanHint": {
                    "newLine": true,
                    "type": "staticText",
                    "text": "Devices without an MQTT publisher, such as the TSW switches, can only be read over SNMP. Enable the SNMP agent on the device first.",
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "scanRange": {
                    "newLine": true,
                    "type": "text",
                    "label": "Address range",
                    "help": "For example 192.168.1.0/24 or 192.168.1.10-192.168.1.40",
                    "default": "192.168.1.0/24",
                    "xs": 12,
                    "sm": 12,
                    "md": 5,
                    "lg": 3,
                    "xl": 3
                },
                "scanVersion": {
                    "type": "select",
                    "label": "Version",
                    "noTranslation": true,
                    "default": "v2c",
                    "options": [
                        { "label": "v1", "value": "v1" },
                        { "label": "v2c", "value": "v2c" }
                    ],
                    "xs": 12,
                    "sm": 4,
                    "md": 2,
                    "lg": 1,
                    "xl": 1
                },
                "scanCommunity": {
                    "type": "text",
                    "label": "Community",
                    "default": "public",
                    "xs": 12,
                    "sm": 8,
                    "md": 3,
                    "lg": 2,
                    "xl": 2
                },
                "_scan": {
                    "type": "sendTo",
                    "command": "scan",
                    "jsonData": "{\"range\": \"${data.scanRange}\", \"community\": \"${data.scanCommunity}\", \"version\": \"${data.scanVersion}\"}",
                    "label": "Scan",
                    "variant": "contained",
                    "showProcess": true,
                    "useNative": true,
                    "timeout": 120000,
                    "xs": 12,
                    "sm": 12,
                    "md": 2,
                    "lg": 2,
                    "xl": 2
                },
                "_headerDevices": {
                    "newLine": true,
                    "type": "header",
                    "text": "SNMP devices",
                    "size": 3,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "snmpDevices": {
                    "newLine": true,
                    "type": "table",
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12,
                    "items": [
                        {
                            "type": "checkbox",
                            "attr": "enabled",
                            "title": "Active",
                            "width": "70px",
                            "default": true
                        },
                        {
                            "type": "text",
                            "attr": "host",
                            "title": "IP address",
                            "width": "160px",
                            "sort": true,
                            "filter": true,
                            "default": ""
                        },
                        {
                            "type": "number",
                            "attr": "port",
                            "title": "Port",
                            "width": "90px",
                            "min": 1,
                            "max": 65535,
                            "default": 161
                        },
                        {
                            "type": "select",
                            "attr": "version",
                            "title": "Version",
                            "width": "100px",
                            "noTranslation": true,
                            "default": "v2c",
                            "options": [
                                { "label": "v1", "value": "v1" },
                                { "label": "v2c", "value": "v2c" },
                                { "label": "v3", "value": "v3" }
                            ]
                        },
                        {
                            "type": "text",
                            "attr": "community",
                            "title": "Community",
                            "width": "130px",
                            "default": "public"
                        },
                        {
                            "type": "text",
                            "attr": "writeCommunity",
                            "title": "Write community",
                            "width": "150px",
                            "default": ""
                        },
                        {
                            "type": "text",
                            "attr": "apiUser",
                            "title": "Web user",
                            "width": "110px",
                            "default": ""
                        },
                        {
                            "type": "password",
                            "attr": "apiPassword",
                            "title": "Web password",
                            "width": "130px",
                            "default": ""
                        },
                        {
                            "type": "text",
                            "attr": "user",
                            "title": "User",
                            "width": "130px",
                            "default": ""
                        },
                        {
                            "type": "select",
                            "attr": "authProtocol",
                            "title": "Auth protocol",
                            "width": "110px",
                            "noTranslation": true,
                            "default": "sha",
                            "options": [
                                { "label": "SHA", "value": "sha" },
                                { "label": "MD5", "value": "md5" }
                            ]
                        },
                        {
                            "type": "text",
                            "attr": "authKey",
                            "title": "Auth key",
                            "width": "130px",
                            "default": ""
                        },
                        {
                            "type": "select",
                            "attr": "privProtocol",
                            "title": "Priv protocol",
                            "width": "110px",
                            "noTranslation": true,
                            "default": "aes",
                            "options": [
                                { "label": "AES", "value": "aes" },
                                { "label": "DES", "value": "des" }
                            ]
                        },
                        {
                            "type": "text",
                            "attr": "privKey",
                            "title": "Priv key",
                            "width": "130px",
                            "default": ""
                        },
                        {
                            "type": "number",
                            "attr": "pollInterval",
                            "title": "Poll interval",
                            "width": "120px",
                            "min": 5000,
                            "max": 3600000,
                            "default": 30000
                        }
                    ]
                },
                "_headerBranches": {
                    "newLine": true,
                    "type": "header",
                    "text": "Optional data",
                    "size": 3,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "_branchHint": {
                    "newLine": true,
                    "type": "staticText",
                    "text": "These are off by default: they expose the device location and identifiable clients, and the wireless tables change with every poll.",
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "snmpGps": {
                    "newLine": true,
                    "type": "checkbox",
                    "label": "GPS position",
                    "default": false,
                    "xs": 12,
                    "sm": 12,
                    "md": 4,
                    "lg": 3,
                    "xl": 3
                },
                "snmpWireless": {
                    "type": "checkbox",
                    "label": "Wi-Fi radios and networks",
                    "default": false,
                    "xs": 12,
                    "sm": 12,
                    "md": 4,
                    "lg": 3,
                    "xl": 3
                },
                "snmpHotspot": {
                    "type": "checkbox",
                    "label": "Hotspot sessions",
                    "default": false,
                    "xs": 12,
                    "sm": 12,
                    "md": 4,
                    "lg": 3,
                    "xl": 3
                },
                "snmpWifiClients": {
                    "type": "checkbox",
                    "label": "Wi-Fi client list",
                    "help": "MAC address of every associated station",
                    "default": false,
                    "xs": 12,
                    "sm": 12,
                    "md": 4,
                    "lg": 3,
                    "xl": 3
                },
                "_headerTraps": {
                    "newLine": true,
                    "type": "header",
                    "text": "Traps",
                    "size": 3,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "_trapHint": {
                    "newLine": true,
                    "type": "staticText",
                    "text": "Configure the device to send traps to this host under Services → SNMP → Trap Settings. Most Teltonika traps carry no values, so a trap is recorded and triggers an immediate poll of that device.",
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "trapsEnabled": {
                    "newLine": true,
                    "type": "checkbox",
                    "label": "Receive traps",
                    "default": false,
                    "xs": 12,
                    "sm": 12,
                    "md": 4,
                    "lg": 3,
                    "xl": 3
                },
                "trapPort": {
                    "type": "number",
                    "label": "Port",
                    "help": "162 requires root on Linux",
                    "min": 1,
                    "max": 65535,
                    "default": 162,
                    "hidden": "!data.trapsEnabled",
                    "xs": 12,
                    "sm": 4,
                    "md": 2,
                    "lg": 1,
                    "xl": 1
                },
                "trapCommunity": {
                    "type": "text",
                    "label": "Community",
                    "default": "public",
                    "hidden": "!data.trapsEnabled",
                    "xs": 12,
                    "sm": 8,
                    "md": 3,
                    "lg": 2,
                    "xl": 2
                },
                "_credentialHint": {
                    "newLine": true,
                    "type": "staticText",
                    "text": "Community strings and SNMPv3 keys in this table are stored encrypted with the system secret. Anyone with access to the ioBroker host can still read them, so grant no more rights than the adapter needs.",
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "_apiHint": {
                    "newLine": true,
                    "type": "staticText",
                    "text": "Web user and password are only needed to switch PoE, which SNMP cannot do. The adapter logs in to the Web API of the device over HTTPS and accepts its self-signed certificate.",
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                }
            }
        },
        "presenceTab": {
            "type": "panel",
            "label": "Presence",
            "items": {
                "_presenceHint": {
                    "type": "staticText",
                    "text": "Every row is a person with one or more MAC addresses, separated by commas, and an optional group. The person gets its own branch under presence.persons with present, last arrival and departure, since when, the sums of the day and the last comings and goings; it is present while one of the routers reports one of its addresses as associated to Wi-Fi. Persons of one group are summarised under presence.groups. Read over SNMP only: the MQTT publisher of a router cannot report its clients.",
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "_presenceMacHint": {
                    "newLine": true,
                    "type": "staticText",
                    "text": "Enter the MAC address the router shows under Status → Wireless, not the one printed on the phone: phones use a separate random address per network. It changes again when the network is forgotten and rejoined.",
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "presenceGrace": {
                    "newLine": true,
                    "type": "number",
                    "label": "Grace period",
                    "help": "in seconds, before a device counts as away",
                    "min": 10,
                    "max": 86400,
                    "default": 180,
                    "xs": 12,
                    "sm": 12,
                    "md": 4,
                    "lg": 4,
                    "xl": 4
                },
                "_graceHint": {
                    "type": "staticText",
                    "text": "A phone leaves the association list while it sleeps and reappears seconds later, so a sighting counts for this long. Below about a minute the states will flicker.",
                    "xs": 12,
                    "sm": 12,
                    "md": 8,
                    "lg": 8,
                    "xl": 8
                },
                "_readStations": {
                    "newLine": true,
                    "type": "sendTo",
                    "command": "teltonika:getWifiClients",
                    "label": "Read connected devices",
                    "variant": "contained",
                    "showProcess": true,
                    "useNative": true,
                    "timeout": 60000,
                    "xs": 12,
                    "sm": 12,
                    "md": 4,
                    "lg": 4,
                    "xl": 4
                },
                "_readStationsHint": {
                    "type": "staticText",
                    "text": "Appends every station the configured SNMP devices currently have associated, as inactive rows named after the address. The log lists them with their SSID and says which addresses are random ones, which is how a phone is told from a printer.",
                    "xs": 12,
                    "sm": 12,
                    "md": 8,
                    "lg": 8,
                    "xl": 8
                },
                "presenceHistory": {
                    "newLine": true,
                    "type": "number",
                    "label": "Kept comings and goings",
                    "help": "per person, in the state history",
                    "min": 1,
                    "max": 1000,
                    "default": 50,
                    "xs": 12,
                    "sm": 12,
                    "md": 4,
                    "lg": 2,
                    "xl": 2
                },
                "presenceGuestSsids": {
                    "type": "text",
                    "label": "Guest SSIDs",
                    "help": "separated by commas, their stations are counted under presence.guests",
                    "default": "",
                    "xs": 12,
                    "sm": 12,
                    "md": 4,
                    "lg": 4,
                    "xl": 4
                },
                "presenceUnknown": {
                    "type": "checkbox",
                    "label": "Count unknown stations",
                    "help": "stations nobody watches, as a number and a list under presence.unknown",
                    "default": false,
                    "xs": 12,
                    "sm": 12,
                    "md": 4,
                    "lg": 4,
                    "xl": 4
                },
                "presenceDevices": {
                    "newLine": true,
                    "type": "table",
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12,
                    "items": [
                        {
                            "type": "checkbox",
                            "attr": "enabled",
                            "title": "Active",
                            "width": "70px",
                            "default": true
                        },
                        {
                            "type": "text",
                            "attr": "name",
                            "title": "Name",
                            "width": "200px",
                            "sort": true,
                            "filter": true,
                            "default": ""
                        },
                        {
                            "type": "text",
                            "attr": "group",
                            "title": "Group",
                            "width": "160px",
                            "sort": true,
                            "filter": true,
                            "default": ""
                        },
                        {
                            "type": "text",
                            "attr": "mac",
                            "title": "MAC addresses",
                            "width": "320px",
                            "default": ""
                        },
                        {
                            "type": "number",
                            "attr": "grace",
                            "title": "Grace period",
                            "width": "140px",
                            "min": 10,
                            "max": 86400
                        }
                    ]
                }
            }
        }
    }
}
