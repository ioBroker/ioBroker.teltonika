{
    "name": "iobroker.teltonika",
    "description": "The adapter reads data from Teltonika routers via MQTT and provides it in ioBroker.",
    "version": "0.1.0",
    "author": "bluefox <dogafox@gmail.com>",
    "homepage": "https://github.com/ioBroker/ioBroker.teltonika",
    "repository": {
        "type": "git",
        "url": "https://github.com/ioBroker/ioBroker.teltonika"
    },
    "keywords": [
        "ioBroker",
        "teltonika",
        "router"
    ],
    "dependencies": {
        "@iobroker/adapter-core": "^3.4.3",
        "mqtt-connection": "^4.1.0",
        "net-snmp": "^3.26.3"
    },
    "devDependencies": {
        "@alcalzone/release-script": "^5.2.1",
        "@alcalzone/release-script-plugin-iobroker": "^5.2.0",
        "@alcalzone/release-script-plugin-license": "^5.2.2",
        "@iobroker/adapter-dev": "^1.5.0",
        "@iobroker/eslint-config": "^2.3.4",
        "@iobroker/legacy-testing": "^3.0.0",
        "@iobroker/testing": "^5.3.0",
        "@iobroker/types": "^7.2.2",
        "mqtt": "^5.15.2",
        "typescript": "^6.0.3"
    },
    "bugs": {
        "url": "https://github.com/ioBroker/ioBroker.teltonika/issues"
    },
    "main": "build/main.js",
    "files": [
        "build/",
        "admin/",
        "img/",
        "io-package.json",
        "LICENSE"
    ],
    "scripts": {
        "prepublishOnly": "npm run build",
        "test:integration": "mocha test/adapter.test.js --exit",
        "test:package": "mocha test/package.test.js --exit",
        "test:unit": "mocha test/mib.test.js test/states.test.js test/client.test.js test/poller.test.js test/scan.test.js test/traps.test.js --exit",
        "test": "npm run test:unit && npm run test:integration",
        "lint": "eslint -c eslint.config.mjs",
        "build": "tsc -p tsconfig.build.json",
        "generate-oids": "npm run build && node tools/generate-oids.js",
        "release": "release-script",
        "release-patch": "release-script patch --yes",
        "release-minor": "release-script minor --yes",
        "release-major": "release-script major --yes",
        "update-packages": "npx -y npm-check-updates"
    },
    "engines": {
        "node": ">=20.0.0"
    },
    "license": "MIT"
}
